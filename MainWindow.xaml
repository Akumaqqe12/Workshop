<Window x:Class="MusicRepairShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicRepairShop"
        xmlns:viewModels="clr-namespace:MusicRepairShop.ViewModels"
        xmlns:views="clr-namespace:MusicRepairShop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Меню навигации -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Клиенты" Command="{Binding NavigateCommand}" 
                        CommandParameter="Clients" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Инструменты" Command="{Binding NavigateCommand}" 
                        CommandParameter="Instruments" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Услуги" Command="{Binding NavigateCommand}" 
                        CommandParameter="Services" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Материалы" Command="{Binding NavigateCommand}" 
                        CommandParameter="Materials" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Мастера" Command="{Binding NavigateCommand}" 
                        CommandParameter="Masters" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Заказы" Command="{Binding NavigateCommand}" 
                        CommandParameter="Orders" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="Отчеты" Command="{Binding NavigateCommand}" 
                        CommandParameter="Reports" Style="{StaticResource NavButtonStyle}"/>
                
                <Separator Style="{StaticResource VerticalSeparator}"/>
                
                <Button Content="Выход" Command="{Binding ExitCommand}" 
                        Style="{StaticResource ExitButtonStyle}" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Контент страницы -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewModels:ClientsViewModel}">
                    <views:ClientsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:InstrumentsViewModel}">
                    <views:InstrumentsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ServicesViewModel}">
                    <views:ServicesView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:MaterialsViewModel}">
                    <views:MaterialsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:MastersViewModel}">
                    <views:MastersView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:OrdersViewModel}">
                    <views:OrdersView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
                    <views:ReportsView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>