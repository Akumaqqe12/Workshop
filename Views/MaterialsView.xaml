<UserControl x:Class="MusicRepairShop.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicRepairShop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.DataContext>
        <local:MaterialsViewModel/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <Style x:Key="StockIndicatorStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="#f5f5f5" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,10,0" 
                         ToolTip="Поиск по названию, категории или описанию">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="3">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="🔍 Поиск материалов..." 
                                                           IsHitTestVisible="False" 
                                                           VerticalAlignment="Center" 
                                                           Margin="5,0,0,0"
                                                           Foreground="Gray"
                                                           Visibility="{Binding Text, 
                                                                        RelativeSource={RelativeSource TemplatedParent},
                                                                        Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <Button Content="Добавить" Command="{Binding AddCommand}" 
                        Style="{StaticResource AddButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Style="{StaticResource SaveButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" 
                        Style="{StaticResource DeleteButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource RefreshButtonStyle}"/>
                
                <Separator Width="20" Visibility="Hidden"/>
                
                <CheckBox IsChecked="{Binding ShowOnlyLowStock}" 
                          Content="Только низкий запас"
                          VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список материалов -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Materials}" 
                      SelectedItem="{Binding SelectedMaterial}" 
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0,0,1,0" BorderBrush="#e0e0e0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="Запас" Binding="{Binding CurrentStock}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Мин." Binding="{Binding MinimumStock}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Статус" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StockIndicatorStyle}"
                                        Background="{Binding IsLowStock, 
                                                   Converter={StaticResource BoolToStockColorConverter}}">
                                    <TextBlock Text="{Binding IsLowStock, 
                                                  Converter={StaticResource BoolToStockTextConverter}}"
                                               Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Цена" 
                                        Binding="{Binding SalePrice, StringFormat=C2}" 
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e0e0e0"/>
                        <Setter Property="Height" Value="35"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#e3f2fd"/>
                                <Setter Property="BorderBrush" Value="#2196f3"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Background" Value="#fff3cd"/>
                                <Setter Property="BorderBrush" Value="#ffeaa7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            
            <!-- Форма редактирования -->
            <Border Grid.Column="1" Background="White" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Редактирование материала" 
                                   FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,20" Foreground="#2c3e50"/>
                        
                        <!-- Основная информация -->
                        <Border Background="#f8f9fa" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Основная информация" 
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Название:" Width="120"/>
                                    <TextBox Text="{Binding EditingMaterial.MaterialName}" 
                                             Width="250">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Категория:" Width="120"/>
                                    <TextBox Text="{Binding EditingMaterial.Category}" 
                                             Width="250"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Ед. измерения:" Width="120"/>
                                    <ComboBox Text="{Binding EditingMaterial.Unit}" 
                                              IsEditable="True" Width="250">
                                        <ComboBoxItem Content="шт."/>
                                        <ComboBoxItem Content="м"/>
                                        <ComboBoxItem Content="кг"/>
                                        <ComboBoxItem Content="л"/>
                                        <ComboBoxItem Content="уп."/>
                                        <ComboBoxItem Content="набор"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <StackPanel>
                                    <TextBlock Text="Описание" 
                                               FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding EditingMaterial.Description}" 
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="80" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Складские запасы -->
                        <Border Background="#e8f4fd" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Складские запасы" 
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="Текущий запас:" Grid.Row="0" Grid.Column="0" 
                                               Width="120" Margin="0,0,10,5"/>
                                    <TextBox Text="{Binding EditingMaterial.CurrentStock}" 
                                             Grid.Row="0" Grid.Column="1">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    
                                    <TextBlock Text="Минимальный запас:" Grid.Row="1" Grid.Column="0" 
                                               Width="120" Margin="0,0,10,5"/>
                                    <TextBox Text="{Binding EditingMaterial.MinimumStock}" 
                                             Grid.Row="1" Grid.Column="1">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                                
                                <Border Background="{Binding EditingMaterial.IsLowStock, 
                                                   Converter={StaticResource BoolToStockColorConverter}}" 
                                        CornerRadius="5" Padding="10">
                                    <TextBlock Text="{Binding EditingMaterial.IsLowStock, 
                                                  Converter={StaticResource BoolToStockTextConverter}}"
                                               Foreground="White" FontWeight="Bold" 
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- Цены -->
                        <Border Background="#f0f8f0" Padding="15" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Цены" 
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="Закупочная цена:" Grid.Row="0" Grid.Column="0" 
                                               Width="120" Margin="0,0,10,5"/>
                                    <TextBox Text="{Binding EditingMaterial.PurchasePrice}" 
                                             Grid.Row="0" Grid.Column="1">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="руб." Grid.Row="0" Grid.Column="2" 
                                               Margin="5,0,0,0"/>
                                    
                                    <TextBlock Text="Цена продажи:" Grid.Row="1" Grid.Column="0" 
                                               Width="120" Margin="0,0,10,5"/>
                                    <TextBox Text="{Binding EditingMaterial.SalePrice}" 
                                             Grid.Row="1" Grid.Column="1">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="руб." Grid.Row="1" Grid.Column="2" 
                                               Margin="5,0,0,0"/>
                                    
                                    <TextBlock Text="Наценка:" Grid.Row="2" Grid.Column="0" 
                                               Width="120" Margin="0,0,10,5"/>
                                    <TextBlock Text="{Binding Margin, StringFormat=F2}" 
                                               Grid.Row="2" Grid.Column="1" 
                                               FontWeight="Bold"
                                               Foreground="{Binding Margin, 
                                                           Converter={StaticResource MarginToColorConverter}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Статистика -->
                        <Border Background="#fff3cd" Padding="10" CornerRadius="5" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Статистика склада" 
                                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="Всего материалов:" Grid.Row="0" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Materials.Count, Mode=OneWay}" 
                                               Grid.Row="0" Grid.Column="1" 
                                               FontWeight="Bold"/>
                                    
                                    <TextBlock Text="С низким запасом:" Grid.Row="1" Grid.Column="0"/>
                                    <TextBlock Text="{Binding LowStockCount}" 
                                               Grid.Row="1" Grid.Column="1" 
                                               FontWeight="Bold"
                                               Foreground="#d35400"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>