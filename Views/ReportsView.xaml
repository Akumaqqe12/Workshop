<UserControl x:Class="MusicRepairShop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicRepairShop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.DataContext>
        <local:ReportsViewModel/>
    </UserControl.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Панель параметров -->
        <Border Grid.Row="0" Background="#f5f5f5" Padding="15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,10,0"/>
                    <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,20,0"/>
                    
                    <TextBlock Text="Отчет:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox SelectedItem="{Binding SelectedReport}" Width="150">
                        <ComboBoxItem Content="Сводка"/>
                        <ComboBoxItem Content="Заказы"/>
                        <ComboBoxItem Content="Мастера"/>
                        <ComboBoxItem Content="Услуги"/>
                        <ComboBoxItem Content="Материалы"/>
                    </ComboBox>
                    
                    <Button Content="Сформировать" Command="{Binding GenerateCommand}" 
                            Style="{StaticResource GenerateButtonStyle}" Margin="20,0,10,0"/>
                    <Button Content="Экспорт" Command="{Binding ExportCommand}" 
                            Style="{StaticResource ExportButtonStyle}"/>
                </StackPanel>
                
                <!-- Сводная информация -->
                <Border Background="White" Padding="10" CornerRadius="5" 
                        BorderThickness="1" BorderBrush="#e0e0e0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#3498db" Padding="10" CornerRadius="5" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Всего заказов" Foreground="White" 
                                           FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalOrders}" Foreground="White" 
                                           FontSize="24" FontWeight="Bold" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#2ecc71" Padding="10" CornerRadius="5" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Завершено" Foreground="White" 
                                           FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CompletedOrders}" Foreground="White" 
                                           FontSize="24" FontWeight="Bold" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#9b59b6" Padding="10" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Общая сумма" Foreground="White" 
                                           FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat=C2}" 
                                           Foreground="White" 
                                           FontSize="24" FontWeight="Bold" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        
        <!-- Контент отчета -->
        <Grid Grid.Row="1">
            <!-- Здесь будут DataGrid для разных отчетов -->
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="True" 
                      IsReadOnly="True" HeadersVisibility="Column"/>
        </Grid>
    </Grid>
</UserControl>