<UserControl x:Class="MusicRepairShop.Views.InstrumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicRepairShop.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.DataContext>
        <local:InstrumentsViewModel/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="#f5f5f5" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,10,0" 
                         ToolTip="Поиск по типу, производителю, модели или серийному номеру">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="3">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="🔍 Поиск инструментов..." 
                                                           IsHitTestVisible="False" 
                                                           VerticalAlignment="Center" 
                                                           Margin="5,0,0,0"
                                                           Foreground="Gray"
                                                           Visibility="{Binding Text, 
                                                                        RelativeSource={RelativeSource TemplatedParent},
                                                                        Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <Button Content="Добавить" Command="{Binding AddCommand}" 
                        Style="{StaticResource AddButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Style="{StaticResource SaveButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" 
                        Style="{StaticResource DeleteButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource RefreshButtonStyle}"/>
            </StackPanel>
        </Border>
        
        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список инструментов -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Instruments}" 
                      SelectedItem="{Binding SelectedInstrument}" 
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0,0,1,0" BorderBrush="#e0e0e0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="120"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="Серийный №" Binding="{Binding SerialNumber}" Width="120"/>
                    <DataGridTextColumn Header="Владелец" Binding="{Binding Client.FullName}" Width="*"/>
                    <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70"/>
                    <DataGridTextColumn Header="Дата регистрации" 
                                        Binding="{Binding RegistrationDate, StringFormat=d}" 
                                        Width="110"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e0e0e0"/>
                        <Setter Property="Height" Value="35"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f8ff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#e3f2fd"/>
                                <Setter Property="BorderBrush" Value="#2196f3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            
            <!-- Форма редактирования -->
            <Border Grid.Column="1" Background="White" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Информация об инструменте" 
                                   FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,20" Foreground="#2c3e50"/>
                        
                        <!-- Клиент -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Владелец" FontWeight="SemiBold" 
                                       Margin="0,0,0,5" Foreground="#34495e"/>
                            <ComboBox ItemsSource="{Binding Clients}" 
                                      SelectedValue="{Binding EditingInstrument.ClientID}"
                                      SelectedValuePath="ClientID">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}">
                                            <TextBlock.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Phone}" 
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Email}"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Основная информация -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Основная информация" FontWeight="SemiBold" 
                                       Margin="0,0,0,5" Foreground="#34495e"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Тип:" Grid.Row="0" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.Type}" 
                                         Grid.Row="0" Grid.Column="1"/>
                                
                                <TextBlock Text="Производитель:" Grid.Row="1" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.Manufacturer}" 
                                         Grid.Row="1" Grid.Column="1"/>
                                
                                <TextBlock Text="Модель:" Grid.Row="2" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.Model}" 
                                         Grid.Row="2" Grid.Column="1"/>
                                
                                <TextBlock Text="Серийный №:" Grid.Row="3" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.SerialNumber}" 
                                         Grid.Row="3" Grid.Column="1"/>
                                
                                <TextBlock Text="Год выпуска:" Grid.Row="4" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.Year}" 
                                         Grid.Row="4" Grid.Column="1">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Validation.HasError" Value="true">
                                                    <Setter Property="ToolTip" 
                                                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                    Path=(Validation.Errors)[0].ErrorContent}"/>
                                                    <Setter Property="Background" Value="#fff0f0"/>
                                                    <Setter Property="BorderBrush" Value="#ff9999"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Дополнительная информация -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Дополнительная информация" FontWeight="SemiBold" 
                                       Margin="0,0,0,5" Foreground="#34495e"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="Цвет:" Grid.Row="0" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.Color}" 
                                         Grid.Row="0" Grid.Column="1"/>
                                
                                <TextBlock Text="Особенности:" Grid.Row="1" Grid.Column="0" 
                                           Width="120" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding EditingInstrument.SpecialFeatures}" 
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" Grid.Row="1" Grid.Column="1"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Информация о датах -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Дата регистрации:" 
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding EditingInstrument.RegistrationDate}" 
                                        IsEnabled="False"
                                        Background="#f5f5f5" BorderBrush="#ddd"/>
                        </StackPanel>
                        
                        <!-- Статус -->
                        <Border Background="#f8f9fa" Padding="10" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Статус" FontWeight="SemiBold" 
                                           Margin="0,0,0,5"/>
                                <TextBlock>
                                    <Run Text="Инструмент:"/>
                                    <Run Text="{Binding SelectedInstrument.Client.FullName, 
                                                 FallbackValue='не выбран'}" 
                                         FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="Всего инструментов у клиента:"/>
                                    <Run Text="{Binding SelectedInstrument.Client.Instruments.Count, 
                                           Mode=OneWay,      FallbackValue='0'}" 
                                         FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>