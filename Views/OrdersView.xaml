<UserControl x:Class="MusicRepairShop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicRepairShop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <UserControl.DataContext>
        <local:OrdersViewModel/>
    </UserControl.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="#f5f5f5" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,10,0" Padding="5" 
                         VerticalContentAlignment="Center" 
                         ToolTip="Поиск по номеру, клиенту или статусу"/>
                
                <Button Content="Новый заказ" Command="{Binding AddCommand}" 
                        Style="{StaticResource AddButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Style="{StaticResource SaveButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" 
                        Style="{StaticResource DeleteButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource RefreshButtonStyle}" Margin="0,0,10,0"/>
                
                <Separator Width="20" Visibility="Hidden"/>
                
                <Button Content="Принят" Command="{Binding ChangeStatusCommand}" 
                        CommandParameter="Принят" 
                        Style="{StaticResource StatusButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="В работе" Command="{Binding ChangeStatusCommand}" 
                        CommandParameter="В работе" 
                        Style="{StaticResource StatusButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Готов" Command="{Binding ChangeStatusCommand}" 
                        CommandParameter="Готов" 
                        Style="{StaticResource StatusButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Выдан" Command="{Binding ChangeStatusCommand}" 
                        CommandParameter="Выдан" 
                        Style="{StaticResource StatusButtonStyle}"/>
            </StackPanel>
        </Border>
        
        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список заказов -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Orders}" 
                      SelectedItem="{Binding SelectedOrder}" 
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="80"/>
                    <DataGridTextColumn Header="Дата" 
                                        Binding="{Binding OrderDate, StringFormat=d}" 
                                        Width="80"/>
                    <DataGridTextColumn Header="Клиент" 
                                        Binding="{Binding Client.FullName}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Инструмент" 
                                        Binding="{Binding Instrument.FullDescription}" 
                                        Width="200"/>
                    <DataGridTextColumn Header="Мастер" 
                                        Binding="{Binding Master.FullName}" 
                                        Width="150"/>
                    <DataGridTextColumn Header="Сумма" 
                                        Binding="{Binding TotalAmount, StringFormat=C2}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource StatusToColorConverter}">
                                            <Binding Path="Status"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Форма заказа -->
            <Border Grid.Column="1" Background="White" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Основная информация" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Номер:" Width="100" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EditingOrder.OrderNumber}" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Клиент:" Width="100" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Clients}" 
                                              SelectedValue="{Binding EditingOrder.ClientID}"
                                              SelectedValuePath="ClientID" 
                                              DisplayMemberPath="FullName"
                                              Width="250"/>

                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Инструмент:" Width="100" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Instruments}" 
                                              SelectedValue="{Binding EditingOrder.InstrumentID}"
                                              SelectedValuePath="InstrumentID" 
                                              DisplayMemberPath="FullDescription"
                                              Width="250"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Мастер:" Width="100" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Masters}" 
                                              SelectedValue="{Binding EditingOrder.MasterID}"
                                              SelectedValuePath="MasterID" 
                                              DisplayMemberPath="FullName"
                                              Width="250"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Дата заказа:" Width="100" VerticalAlignment="Center"/>
                                    <DatePicker SelectedDate="{Binding EditingOrder.OrderDate}" 
                                                Width="120"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="План. дата:" Width="100" VerticalAlignment="Center"/>
                                    <DatePicker SelectedDate="{Binding EditingOrder.PlannedDate}" 
                                                Width="120"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Статус:" Width="100" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding EditingOrder.Status}" 
                                              Width="120">
                                        <ComboBoxItem Content="Принят"/>
                                        <ComboBoxItem Content="В работе"/>
                                        <ComboBoxItem Content="Готов"/>
                                        <ComboBoxItem Content="Выдан"/>
                                        <ComboBoxItem Content="Отменен"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Финансы" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Предоплата:" Width="100" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding EditingOrder.Prepayment}" 
                                             Width="100"/>
                                    <TextBlock Text="руб." Margin="5,0,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Общая сумма:" Width="100" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EditingOrder.TotalAmount, StringFormat=C2}" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Позиции заказа" Margin="0,0,0,10">
                            <StackPanel>
                                <DataGrid ItemsSource="{Binding SelectedOrder.OrderItems}" 
                                          AutoGenerateColumns="False" Height="150"
                                          CanUserAddRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Наименование" 
                                                            Binding="{Binding ItemName}" 
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Кол-во" 
                                                            Binding="{Binding Quantity}" 
                                                            Width="60"/>
                                        <DataGridTextColumn Header="Цена" 
                                                            Binding="{Binding UnitPrice, StringFormat=C2}" 
                                                            Width="80"/>
                                        <DataGridTextColumn Header="Сумма" 
                                                            Binding="{Binding Subtotal, StringFormat=C2}" 
                                                            Width="80"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Command="{Binding DataContext.RemoveItemCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SmallDeleteButton}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                
                                <Border Background="#f5f5f5" Padding="5" Margin="0,10,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="Услуга:" Width="80" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding Services}" 
                                                      SelectedValue="{Binding EditingOrderItem.ServiceID}"
                                                      SelectedValuePath="Id" 
                                                      DisplayMemberPath="ServiceName"
                                                      Width="200">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Style.Triggers>
                                                            <Trigger Property="SelectedValue" Value="0">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Text="или" Margin="10,0,10,0"/>
                                            <TextBlock Text="Материал:" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding Materials}" 
                                                      SelectedValue="{Binding EditingOrderItem.MaterialID}"
                                                      SelectedValuePath="Id" 
                                                      DisplayMemberPath="MaterialName"
                                                      Width="200"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock Text="Количество:" Width="80" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding EditingOrderItem.Quantity}" 
                                                     Width="80"/>
                                            <TextBlock Text="Цена:" Width="40" 
                                                       VerticalAlignment="Center" Margin="20,0,0,0"/>
                                            <TextBox Text="{Binding EditingOrderItem.UnitPrice}" 
                                                     Width="80"/>
                                            <Button Content="Добавить" 
                                                    Command="{Binding AddItemCommand}"
                                                    Style="{StaticResource SmallAddButton}" 
                                                    Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Примечания">
                            <TextBox Text="{Binding EditingOrder.Notes}" 
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="80" VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>