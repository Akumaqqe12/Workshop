<UserControl x:Class="MusicRepairShop.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicRepairShop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.DataContext>
        <local:ServicesViewModel/>
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <Style x:Key="CategoryStyle" TargetType="Border">
            <Setter Property="Background" Value="#f8f9fa"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="#f5f5f5" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,10,0" 
                         ToolTip="Поиск по названию, категории или описанию">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="3">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="🔍 Поиск услуг..." 
                                                           IsHitTestVisible="False" 
                                                           VerticalAlignment="Center" 
                                                           Margin="5,0,0,0"
                                                           Foreground="Gray"
                                                           Visibility="{Binding Text, 
                                                                        RelativeSource={RelativeSource TemplatedParent},
                                                                        Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <Button Content="Добавить" Command="{Binding AddCommand}" 
                        Style="{StaticResource AddButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                        Style="{StaticResource SaveButtonStyle}" Margin="0,0,5,0"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" 
                        Style="{StaticResource DeleteButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource RefreshButtonStyle}"/>
                
                <Separator Width="20" Visibility="Hidden"/>
                
                <CheckBox IsChecked="{Binding ShowOnlyActive}" 
                          Content="Только активные"
                          VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список услуг -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Services}" 
                      SelectedItem="{Binding SelectedService}" 
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0,0,1,0" BorderBrush="#e0e0e0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding ServiceName}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Цена" 
                                        Binding="{Binding Price, StringFormat=C2}" 
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#27ae60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Время (ч)" 
                                        Binding="{Binding StandardTime, StringFormat=F1}" 
                                        Width="80"/>
                    <DataGridCheckBoxColumn Header="Активна" 
                                            Binding="{Binding IsActive}" 
                                            Width="70"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#e0e0e0"/>
                        <Setter Property="Height" Value="35"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#e3f2fd"/>
                                <Setter Property="BorderBrush" Value="#2196f3"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="#999"/>
                                <Setter Property="Background" Value="#f5f5f5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            
            <!-- Форма редактирования -->
            <Border Grid.Column="1" Background="White" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Редактирование услуги" 
                                   FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,20" Foreground="#2c3e50"/>
                        
                        <!-- Основная информация -->
                        <Border Style="{StaticResource CategoryStyle}">
                            <StackPanel>
                                <TextBlock Text="Основная информация" 
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Название:" Width="100"/>
                                    <TextBox Text="{Binding EditingService.ServiceName}" 
                                             Width="250">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Категория:" Width="100"/>
                                    <TextBox Text="{Binding EditingService.Category}" 
                                             Width="250"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Активна:" Width="100"/>
                                    <CheckBox IsChecked="{Binding EditingService.IsActive}" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Цена и время -->
                        <Border Style="{StaticResource CategoryStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Стоимость и время" 
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Цена:" Width="100"/>
                                    <TextBox Text="{Binding EditingService.Price}" 
                                             Width="120">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="руб." Margin="5,0,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Стандартное время:" Width="100"/>
                                    <TextBox Text="{Binding EditingService.StandardTime}" 
                                             Width="120">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Validation.HasError" Value="true">
                                                        <Setter Property="ToolTip" 
                                                                Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                                        <Setter Property="Background" Value="#fff0f0"/>
                                                        <Setter Property="BorderBrush" Value="#ff9999"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="часов" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Описание -->
                        <Border Style="{StaticResource CategoryStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Описание" 
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding EditingService.Description}" 
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="100" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Статистика -->
                        <Border Background="#e8f5e9" Padding="10" CornerRadius="5" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Статистика" 
                                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="Всего услуг:" Grid.Row="0" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Services.Count, Mode=OneWay}" 
                                               Grid.Row="0" Grid.Column="1" 
                                               FontWeight="Bold"/>
                                    
                                    <TextBlock Text="Активных:" Grid.Row="1" Grid.Column="0"/>
                                    <TextBlock Text="{Binding ActiveServicesCount}" 
                                               Grid.Row="1" Grid.Column="1" 
                                               FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>