<Application x:Class="MusicRepairShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:musicRepairShop="clr-namespace:MusicRepairShop"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Конвертеры -->
        <musicRepairShop:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <musicRepairShop:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <musicRepairShop:BoolToStockColorConverter x:Key="BoolToStockColorConverter"/>
        <musicRepairShop:BoolToStockTextConverter x:Key="BoolToStockTextConverter"/>
        <musicRepairShop:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
        <musicRepairShop:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>
        <musicRepairShop:MarginToColorConverter x:Key="MarginToColorConverter"/>
        
        <!-- Стили кнопок -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495e"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1abc9c"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27ae60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980b9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e74c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c0392b"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стиль для кнопки Обновить -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f39c12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="Обновить"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d68910"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="StatusButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#95a5a6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7f8c8d"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стили для отчетов -->
        <Style x:Key="GenerateButtonStyle" TargetType="Button" BasedOn="{StaticResource SaveButtonStyle}">
            <Setter Property="Content" Value="Сформировать"/>
        </Style>
        
        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource SaveButtonStyle}">
            <Setter Property="Background" Value="#9b59b6"/>
            <Setter Property="Content" Value="Экспорт"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8e44ad"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стиль для маленьких кнопок -->
        <Style x:Key="SmallAddButton" TargetType="Button" BasedOn="{StaticResource AddButtonStyle}">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="SmallDeleteButton" TargetType="Button" BasedOn="{StaticResource DeleteButtonStyle}">
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        
        <!-- Разделитель -->
        <Style x:Key="VerticalSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#34495e"/>
        </Style>
        
        <!-- Стиль для выхода -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e74c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#e74c3c"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e74c3c"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Базовые стили для элементов управления -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        
        <Style TargetType="DatePicker">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        
        <!-- Стиль для DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#f9f9f9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#f5f5f5"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderBrush" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#f0f0f0"/>
            <Setter Property="Height" Value="35"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f5f9ff"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#e3f2fd"/>
                    <Setter Property="BorderBrush" Value="#2196f3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>